	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;分层&lt;/th&gt;
					&lt;th&gt;数量&lt;/th&gt;
					&lt;th&gt;内容&lt;/th&gt;
			&lt;/tr&gt;
